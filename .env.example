# Server-only Places API (New) web-service key. Never prefix this with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Separate browser/referrer-restricted key for Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Existing Phase 3C.1 local reviewed-data preview; required for this pilot.
LIA_PROVIDER_DETAIL_SOURCE=local

# Explicit opt-in for the approved local Google pilot.
LIA_GOOGLE_PLACES_PREVIEW=1

# Supabase server configuration. Never expose the service-role key to browser code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact comma-separated Lia staff emails. Keep this server-only and provision Auth users separately.
LIA_STAFF_EMAILS=

# Canonical application origin used for staff magic-link callbacks (for example local or production origin).
LIA_APP_ORIGIN=
