# Server-only Places API (New) web-service key. Never prefix this with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Separate browser/referrer-restricted key for Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Existing Phase 3C.1 local reviewed-data preview; required for this pilot.
LIA_PROVIDER_DETAIL_SOURCE=local

# Explicit opt-in for the approved local Google pilot.
LIA_GOOGLE_PLACES_PREVIEW=1
